# Copy to api/.env.local (gitignored) and fill in. Run with:  npm run start:local
# Never commit real values. Deployed environments don't use this file: secrets come from
# Secret Manager and other settings from GitHub environment variables (see deploy/SETUP.md).

# --- Secrets (production: Secret Manager) ---
# MongoDB connection string; must be a replica set.
BOND_MONGO_URL=mongodb://127.0.0.1:27018/?replicaSet=bond0
# Base64, 32 bytes. Leave unset locally to use the generated data/encryption.key.
# BOND_ENCRYPTION_KEY=
# Resend API key (https://resend.com/api-keys). Unset: emails are printed to the console.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Stripe, for the organization wallet (Organization > Wallet). Without a secret key the wallet is switched off.
# Test keys only for now (sk_test_...). Local webhooks: run
#   stripe listen --forward-to localhost:4100/v1/stripe/webhook --forward-connect-to localhost:4100/v1/stripe/webhook
# and paste the whsec_... it prints as STRIPE_WEBHOOK_SECRET (one secret covers both while you test locally).
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# In production Stripe gives a separate signing secret for the "connected accounts" endpoint:
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Settings (production: GitHub environment variables) ---
PORT=4100
BOND_MONGO_DB=bond
BOND_PUBLIC_URL=http://localhost:3300
BOND_STAFF_URL=http://localhost:3400
BOND_MAIL_FROM=Bond <no-reply@assetslices.com>
# 'open' lets companies register themselves
BOND_SIGNUP=open
# First admin's one-time setup link is printed on start when no admin exists
# BOND_BOOTSTRAP_EMAIL=you@example.com
# BOND_GCS_BUCKET=
# BOND_DOC_RETENTION_DAYS=90

# --- Local-only switches. Leave these OFF (or unset) in production ---
# 1 = keep emails in memory instead of sending them (overrides RESEND_API_KEY)
# BOND_DEV_MAILBOX=1
# Set to 1 only when served over HTTPS
# BOND_COOKIE_SECURE=1
# Set to 1 only behind a proxy you control
# BOND_TRUST_PROXY=1
