# Where the Bond API is listening (server-side only; the browser never sees it).
# Read when `next dev` / `next build` starts, so set it before building.
BOND_API_URL=http://localhost:4100

# The grid menu in the top right (Support, Docs, Email, Phone, Man in Middle). Each is optional: a tile with no value
# shows greyed out. Baked in when the app is built, so set them before `next build`.
NEXT_PUBLIC_SUPPORT_URL=
# The public API reference (the homepage's /docs), e.g. http://localhost:5173/docs locally. The deploy sets it from niroun-homepage.
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_MITM_URL=

# (The Connect page's quickstart shows the API address from BOND_API_URL above; nothing more to set.)
